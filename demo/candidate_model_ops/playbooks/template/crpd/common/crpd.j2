interfaces {
{% for interface in item.if_list %}
    /*{{ interface.original_if }}*/
    {{ interface.name | regex_replace('\.0', '') }} {
{% if interface.description %}
        description "{{ interface.description | regex_replace('"', '') }}"
{% endif %}
        unit 0 {
            mtu 1500
            family inet {
{% set vrrp_groups = interface.fhrp | default([]) | selectattr('protocol', 'equalto', 'vrrp') | list %}
{% if vrrp_groups | length > 0 %}
                address {{ interface.ipv4 }} {
{% for group in vrrp_groups %}
                    vrrp-group {{ group['group-id'] }} {
{% for vip in group['virtual-address'] %}
                        virtual-address {{ vip }} {
                            device-name  {{ interface.name | regex_replace('\.0', '') }};
                        }
{% endfor %}
                        priority {{ group['priority'] }};
{% if not group['preempt'] %}
                        no-preempt;
{% endif %}
                        accept-data;
                    }
{% endfor %}
                }
{% else %}
                address {{ interface.ipv4 }};
{% endif %}
            }
        }
    }
{% endfor %}
}
routing-instances {
    mgmt {
        instance-type vrf;
        interface eth0;
        route-distinguisher 65000:1;
        vrf-target target:65000:1;
    }
}
